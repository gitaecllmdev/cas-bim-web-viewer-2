        "studSpacingIn": 16,
        "mils": 33,
        "orderLengths": "exact",
        "splitTallWalls": false,
        "multiLevel": "base",
        "sheet": {
            "label": "4' x 12'",
            "sf": 48
        },
        "sheathingSheet": {
            "label": "4' x 8'",
            "sf": 32
        },
        "framingWastePct": 5,
        "boardWastePct": 10,
